{
  "name": "perio-voice",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "setup": "uv sync --frozen && uv run python scripts/fetch_grammar_model.py",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:asr": "uv run uvicorn server.app:app --host 127.0.0.1 --port 8000 --reload",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.20.3",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.22.0",
    "@typescript-eslint/parser": "8.22.0",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vitest-axe": "0.1.0"
  }
}
